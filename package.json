{
  "name": "@elithrar/greyui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BeOS R5 / Haiku-inspired React component library extracted from WorkbenchOS.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grey-ui.js"
    },
    "./styles.css": "./dist/grey-ui.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "scripts": {
    "build": "npm run build:types && vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:docs": "vite build --config docs/vite.config.ts",
    "dev:docs": "vite --config docs/vite.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "deploy:docs": "npm run build:docs && wrangler deploy --config docs/wrangler.jsonc",
    "verify:docs": "npm run build:docs && wrangler deploy --dry-run --config docs/wrangler.jsonc"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0"
  },
  "license": "UNLICENSED",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elithrar/greyUI.git"
  }
}
