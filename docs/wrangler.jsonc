{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "greyui",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "greyui.questionable.services",
      "custom_domain": true,
    },
  ],
}
